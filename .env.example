# OpenAI-compatible image service. Base URL includes the version prefix.
# Defaults to a local service on http://127.0.0.1:3425/v1 when unset.
# IMAGE_API_BASE_URL=https://api.example.com/v1

# Bearer key for the image service. Leave empty for keyless local services.
# IMAGE_API_KEY=sk-...

# Default model. It is always offered even if /models does not advertise it.
# IMAGE_MODEL=codex/gpt-image-2.5

# Optional comma-separated allowlist. When set, /models is not queried at all.
# IMAGE_MODELS=gpt-image-1,codex/gpt-image-2.5

# Per-generation wait limit in milliseconds (default 120000).
# IMAGE_TIMEOUT_MS=120000

# Chat/vision service for wardrobe captions and AI outfit picks.
# Omit both to reuse the image service endpoint and key.
# CHAT_API_BASE_URL=https://api.example.com/v1
# CHAT_API_KEY=sk-...

# Deployment shape: set the public origin to allow non-loopback hosts.
# Setting it also disables the local simulated top-up and the raw /api/tryon endpoint.
# PUBLIC_ORIGIN=https://your-domain.example

# Set to 1 to re-enable the simulated top-up and raw /api/tryon in a deployment shape.
# ENABLE_SIMULATED_PAYMENTS=1

# Taobao / Douyin cookies for direct (no-browser) product image parsing.
# JSON shape: {"taobao":"cookie string","douyin":"cookie string"}. Defaults to data/cookies.json (git-ignored).
# TRYON_COOKIE_FILE=data/cookies.json

# Experimental ComfyUI workflow; configure only after your trusted GPU instance is ready.
# Browser selects comfyui/foxbaze-tryon via Settings; credentials never go to the browser.
# Prefer loopback through an SSH tunnel instead of exposing an unauthenticated GPU port.
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_API_KEY=your-reverse-proxy-bearer-key
# COMFYUI_TIMEOUT_MS=900000
# Original Qwen-Image-Edit (NOT 2509) and matching FoxBaze Alpha LoRA.
# COMFYUI_UNET=qwen_image_edit_fp8_e4m3fn.safetensors
# COMFYUI_CLIP=qwen_2.5_vl_7b_fp8_scaled.safetensors
# COMFYUI_VAE=qwen_image_vae.safetensors
# COMFYUI_LORA=Try_On_Qwen_Edit_Lora.safetensors
# Optional GGUF loader; requires ComfyUI-GGUF. Set UNET to your actual GGUF filename.
# COMFYUI_UNET_TYPE=gguf
