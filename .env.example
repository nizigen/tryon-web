# Optional: override the image service's local gateway address.
# Otherwise read the configured API base URL; if absent, use http://127.0.0.1:3425.
# Only a local 127.0.0.1 HTTP gateway is accepted. No provider keys are required here.
# IMAGE_API_BASE_URL=http://127.0.0.1:3425

# Optional MCP path (default below).
IMAGE_API_MCP_PATH=/v1/images

# Preferred configured model; falls back to Codex GPT Image 2, then the first model.
IMAGE_MODEL=codex/gpt-image-2
